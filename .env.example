# Website form emails are sent from the company's own mailbox (SMTP). See README.md "Form emails".
# The mailbox that sends the emails, and its password (or app password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=website@procusghana.com
SMTP_PASS=
# Optional:
# SMTP_SECURE=true            # only for unusual ports: true = SSL, false = STARTTLS
# MAIL_FROM_NAME=Procus Ghana Website
# MAIL_TO=info@procusghana.com
# MAIL_CC=                    # comma-separated addresses to copy, if any
# SMTP_DEBUG=1                # log the conversation with the mail server when troubleshooting

# Admin panel (/admin). Nothing is required: the password is built into lib/adminAuth.ts.
# Optional: override the built-in password (at least 8 characters).
ADMIN_PASSWORD=
# Optional: change this to log every admin out without changing the password.
ADMIN_SESSION_SECRET=
# Optional: the website address used in password reset links.
# Default: the site's main address on Netlify, otherwise https://procusghana.com
SITE_URL=
# Where admin edits, uploaded images and form submissions are saved.
# Picked automatically: Netlify Blobs on Netlify, the storage folder everywhere else.
# Set STORAGE=files or STORAGE=netlify to force one.
STORAGE=
# Optional: the storage folder when not on Netlify. Defaults to ./storage inside the project.
CONTENT_DIR=
